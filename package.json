{
  "name": "my-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "app": "tauri dev",
    "app:cleaner": "tauri dev --config src-tauri/tauri.cleaner.conf.json",
    "app:paper": "tauri dev --config src-tauri/tauri.paper.conf.json",
    "app:docs": "tauri dev --config src-tauri/tauri.docs.conf.json",
    "app:netdisk": "tauri dev --config src-tauri/tauri.netdisk.conf.json",
    "app:media": "tauri dev --config src-tauri/tauri.media.conf.json",
    "dev:netdisk": "vite --mode netdisk",
    "build:netdisk": "tsc && vite build --mode netdisk",
    "test:netdisk": "node --test tests/netdisk*.test.mjs",
    "dev:media": "vite --mode media",
    "build:media": "tsc && vite build --mode media",
    "test:media": "node --test tests/media.test.mjs",
    "dev": "vite",
    "dev:docs": "vite --mode docs",
    "dev:paper": "vite --mode paper",
    "dev:cleaner": "vite --mode cleaner",
    "web": "vite --open",
    "web:docs": "vite --mode docs --open",
    "web:paper": "vite --mode paper --open",
    "web:cleaner": "vite --mode cleaner --open",
    "tauri:cleaner": "tauri dev --config src-tauri/tauri.cleaner.conf.json",
    "tauri:paper": "tauri dev --config src-tauri/tauri.paper.conf.json",
    "tauri:docs": "tauri dev --config src-tauri/tauri.docs.conf.json",
    "build": "tsc && vite build",
    "build:docs": "tsc && vite build --mode docs",
    "package:mac": "bash scripts/build-macos.sh all",
    "package:mac-arm64": "bash scripts/build-macos.sh arm64",
    "package:mac-intel": "bash scripts/build-macos.sh x64",
    "package:windows": "tauri build --bundles nsis",
    "test:paper": "node --test tests/paper*.test.mjs tests/pdfjs-offline.test.mjs",
    "test:paper-ui": "node tests/run-paper-reader-ui.mjs",
    "build:paper": "tsc && vite build --mode paper",
    "build:cleaner": "tsc && vite build --mode cleaner",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.15.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
